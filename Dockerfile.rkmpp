FROM ghcr.io/immich-app/base-server-dev:202610291416@sha256:5f4f9f77059e1cd0182994419a19f4ee045c3fd48e611f5e77623ed63f7aa1e4 AS builder
ENV CI=1 \
    PNPM_HOME=/buildcache/pnpm-store \
    PATH="/buildcache/pnpm-store:$PATH"
RUN npm install --global pnpm@12.15.0 && pnpm config set store-dir "$PNPM_HOME"
WORKDIR /usr/src/app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .pnpmfile.cjs ./

FROM builder AS sdk
COPY packages/sdk/package.json packages/sdk/package.json
RUN pnpm --filter @immich/sdk install --frozen-lockfile
COPY packages/sdk packages/sdk/
RUN pnpm --filter @immich/sdk build

FROM sdk AS plugin-sdk
COPY packages/plugin-sdk/package.json packages/plugin-sdk/package.json
RUN pnpm --filter @immich/plugin-sdk install --frozen-lockfile
COPY packages/plugin-sdk packages/plugin-sdk/
RUN pnpm --filter @immich/plugin-sdk build

FROM plugin-sdk AS server
COPY server/package.json server/package.json
RUN pnpm --filter immich install --frozen-lockfile
COPY server server/
RUN pnpm --filter immich check && \
    pnpm --filter immich exec vitest run --config test/vitest.config.mjs \
      src/services/hls.service.spec.ts src/services/transcoding.service.spec.ts src/dtos/streaming.dto.spec.ts && \
    pnpm --filter immich build

FROM sdk AS web
COPY web/package.json web/package.json
RUN pnpm --filter immich-web install --frozen-lockfile
COPY i18n i18n/
COPY open-api open-api/
COPY web web/
ARG IMMICH_BUILD=rkmpp-3.4.0-r4-memories
ENV IMMICH_BUILD=${IMMICH_BUILD}
RUN pnpm --filter immich-web exec svelte-kit sync && \
    pnpm --filter immich-web check:svelte && \
    pnpm --filter immich-web check:typescript && \
    pnpm --filter immich-web build

# Reuse matching runtime dependencies, FFmpeg, CLI and core plugins.
FROM ghcr.io/immich-app/immich-server:v3.4.0@sha256:7b7b575029168bfb9eb901d868ce7dbfda0d7818e78aaace29b7b8a08cd4e7d5 AS rkmpp
COPY --from=server /usr/src/app/server/dist /usr/src/app/server/dist
COPY --from=web /usr/src/app/web/build /build/www
COPY LICENSE /licenses/immich-rkmpp/LICENSE
COPY RKMPP_NOTICE /licenses/immich-rkmpp/NOTICE
COPY RKMPP_LICENSES /licenses/immich-rkmpp/third-party
ARG RKMPP_REVISION=local
ARG IMMICH_BUILD=rkmpp-3.4.0-r4-memories
ENV IMMICH_BUILD=${IMMICH_BUILD}
LABEL org.opencontainers.image.title="Immich RKMPP" \
      org.opencontainers.image.version="3.4.0-rkmpp-r4-memories" \
      org.opencontainers.image.source="https://github.com/meitelis/immich-rkmpp" \
      org.opencontainers.image.revision="${RKMPP_REVISION}" \
      cc.immich-rkmpp.upstream-version="3.4.0" \
      cc.immich-rkmpp.upstream-revision="0715bcf8dab4b91118d6184479e2be2767ef8294"
