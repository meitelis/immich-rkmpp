+    hls.stopLoad();
+    hls.trigger(events.Events.BUFFER_FLUSHING, { startOffset: 0, endOffset: Infinity, type: null });
+    hls.startLoad(position);
+  };
+  const connection = (navigator as Navigator & { connection?: EventTarget }).connection;
+  hls.on(events.Events.FRAG_BUFFERED, buffered);
+  video.addEventListener('resize', update);
+  video.addEventListener('timeupdate', update);
+  video.addEventListener('seeking', seeking);
+  window.addEventListener('online', network);
+  document.addEventListener('visibilitychange', foreground);
+  connection?.addEventListener('change', network);
+  const timer = setInterval(update, 1000);
+  return () => {
+    if (signal.aborted) return;
+    controller.abort();
+    clearInterval(timer);
+    hls.trigger = originalTrigger;
+    if (originalNextLevel) Object.defineProperty(hls, 'nextLevel', originalNextLevel);
+    else Reflect.deleteProperty(hls, 'nextLevel');
+    hls.off(events.Events.FRAG_BUFFERED, buffered);
+    video.removeEventListener('resize', update);
+    video.removeEventListener('timeupdate', update);
+    video.removeEventListener('seeking', seeking);
+    if (debug && video.dataset) {
+      for (const key of ['playbackBandwidth', 'playbackLevel', 'playbackCap', 'playbackDropped', 'playbackFrames'])
+        delete video.dataset[key];
+    }
+    window.removeEventListener('online', network);
+    document.removeEventListener('visibilitychange', foreground);
+    connection?.removeEventListener('change', network);
+  };
+}
diff --git a/web/src/lib/utils/direct-playback.ts b/web/src/lib/utils/direct-playback.ts
new file mode 100644
index 0000000000000000000000000000000000000000..965cc6f7e41fb9ab414d98a927fb4db7a963b756
--- /dev/null
+++ b/web/src/lib/utils/direct-playback.ts
@@ -0,0 +1,85 @@
+type DirectMedia = Pick<HTMLVideoElement,
+  'paused' | 'ended' | 'seeking' | 'currentTime' | 'duration' | 'readyState' | 'playbackRate' |
+  'buffered' | 'addEventListener' | 'removeEventListener'>;
+
+// A direct original has no adaptive ladder. Fall back before a persistently
+// draining buffer empties, or after a sustained stall. Pauses and seeks are not
+// evidence of a slow connection. One monitor belongs to one media element.
+export const monitorDirectPlayback = (video: DirectMedia, onFallback: () => void) => {
+  let timer: ReturnType<typeof setInterval> | undefined;
+  let last: { time: number; position: number; ahead: number } | undefined;
+  let stalledAt: number | undefined;
+  let drainingSamples = 0;
+  let disposed = false;
+
+  const reset = () => {
+    last = undefined;
+    stalledAt = undefined;
+    drainingSamples = 0;
+  };
+  const stop = () => {
+    if (timer !== undefined) clearInterval(timer);
+    timer = undefined;
+    reset();
+  };
+  const sample = () => {
+    if (video.paused || video.ended || video.seeking) {
+      reset();
+      return;
+    }
+    const time = performance.now();
+    const position = video.currentTime;
+    let ahead = 0;
+    for (let i = 0; i < video.buffered.length; i++) {
+      if (video.buffered.start(i) <= position + 0.05 && video.buffered.end(i) > position) {
+        ahead = video.buffered.end(i) - position;
+        break;
+      }
+    }
+    // An almost finished original does not need a new HLS session.
+    if (Number.isFinite(video.duration) && video.duration - position <= Math.max(1, ahead + 0.1)) {
+      reset();
+      return;
+    }
+    if (last) {
+      const elapsed = (time - last.time) / 1000;
+      const advanced = position - last.position;
+      if (elapsed > 0 && advanced >= 0 && advanced < 0.1 && video.readyState < 3) {
+        stalledAt ??= last.time;
+      } else {
+        stalledAt = undefined;
+      }
+      const draining = elapsed > 0 && advanced > 0.1 && ahead < 3 &&
+        ahead < last.ahead - elapsed * video.playbackRate * 0.25;
+      drainingSamples = draining ? drainingSamples + 1 : 0;
+      if ((stalledAt !== undefined && time - stalledAt >= 4000) || drainingSamples >= 2) {
+        cleanup();
+        onFallback();
+        return;
+      }
+    }
+    last = { time, position, ahead };
+  };
+  const start = () => {
+    if (disposed || timer !== undefined || video.paused || video.ended) return;
+    reset();
+    timer = setInterval(sample, 1000);
+  };
+  const cleanup = () => {
+    if (disposed) return;
+    disposed = true;
+    stop();
+    video.removeEventListener('play', start);
+    video.removeEventListener('playing', start);
+    video.removeEventListener('pause', stop);
+    video.removeEventListener('ended', stop);
+    video.removeEventListener('seeking', reset);
+  };
+  video.addEventListener('play', start);
+  video.addEventListener('playing', start);
+  video.addEventListener('pause', stop);
+  video.addEventListener('ended', stop);
+  video.addEventListener('seeking', reset);
+  start();
+  return cleanup;
+};
diff --git a/web/src/lib/utils/video-codec.ts b/web/src/lib/utils/video-codec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..69b244bbfa4a673d907f662960c2eae9b4ffb8ac
--- /dev/null
+++ b/web/src/lib/utils/video-codec.ts
@@ -0,0 +1,23 @@
+const codecFailures = new Set([
+  'manifestIncompatibleCodecsError',
+  'bufferAddCodecError',
+  'bufferAppendError',
+  'bufferAppendingError',
+  'fragParsingError',
+]);
+
+export const isHevcCodec = (codec?: string) => /^(?:hvc1|hev1)(?:\.|$)/.test(codec ?? '');
+
+export const isHevcDecodeFailure = (
+  error: { fatal: boolean; type: string; details: string },
+  codec?: string,
+) => error.fatal && error.type !== 'networkError' && codecFailures.has(error.details) && (!codec || isHevcCodec(codec));
+
+export const isMediaDecodeFailure = (code?: number) => code === 3 || code === 4;
+
+export type PlaybackPosition = { currentTime: number; paused: boolean };
+
+export const playbackPosition = (video: PlaybackPosition): PlaybackPosition => ({
+  currentTime: Number.isFinite(video.currentTime) ? Math.max(0, video.currentTime) : 0,
+  paused: video.paused,
+});
